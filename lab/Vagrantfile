# frozen_string_literal: true

require "rbconfig"

host_cpu = RbConfig::CONFIG.fetch("host_cpu")
host_os = RbConfig::CONFIG.fetch("host_os")

unless host_cpu.match?(/x86_64|amd64|x64/i) && host_os.match?(/linux|mingw|mswin/i)
  raise "This lab supports only x86-64 Windows and Linux hosts."
end

# VMware calls configure_networks even when every Kali private network has
# auto_config: false. Vagrant's inherited Debian capability then restarts
# systemd-networkd with an empty network list, dropping the NAT SSH session.
class AttackerNetworkPlugin < Vagrant.plugin("2")
  name "Eye of Sauron Kali network guard"

  guest_capability(:kali, :configure_networks) do
    Class.new do
      def self.configure_networks(_machine, networks)
        raise "The attacker networks must use auto_config: false" unless networks.empty?
      end
    end
  end
end

Vagrant.configure("2") do |config|
  config.vm.box_check_update = false

  # Make the complete repository available to every VM while keeping the
  # Vagrant environment itself in the lab directory.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder "..", "/workspace"

  # Vagrant keeps its first (NAT) adapter for provisioning. The two private
  # networks below carry lab traffic and keep the IDS inline between peers.
  machines = {
    "attacker" => {
      box: "kalilinux/rolling",
      box_version: "2026.2.0",
      hostname: "ids-attacker",
      memory: 3072,
      cpus: 2,
      networks: [{
        ip: "192.168.56.10",
        adapter: 2,
        auto_config: false,
        mac: "005056000210"
      }],
      provision: "provision/attacker.sh",
      gui: true
    },
    "target" => {
      box: "gusztavvargadr/ubuntu-desktop-2404-lts",
      box_version: "2607.0.0",
      hostname: "ids-target",
      memory: 2048,
      cpus: 2,
      networks: [{ip: "192.168.57.20", adapter: 2}],
      provision: "provision/target.sh",
      gui: true
    },
    "ids" => {
      box: "gusztavvargadr/ubuntu-desktop-2404-lts",
      box_version: "2607.0.0",
      hostname: "ids-sensor",
      memory: 3072,
      cpus: 2,
      networks: [
        {ip: "192.168.56.30", adapter: 2},
        {ip: "192.168.57.30", adapter: 3}
      ],
      provision: "provision/ids.sh",
      gui: true
    }
  }

  machines.each do |name, machine|
    config.vm.define name do |node|
      node.vm.box = machine[:box]
      node.vm.box_version = machine[:box_version]
      node.vm.box_architecture = "amd64"
      node.vm.hostname = machine[:hostname]

      machine[:networks].each do |network|
        node.vm.network "private_network", **network
      end

      node.vm.provider "vmware_desktop" do |provider|
        # Current VMware Workstation is the full Pro product even when used
        # under its free licence. Correct the provider's legacy detection so
        # vmrun uses Workstation (`-T ws`) instead of obsolete Player mode.
        provider.force_vmware_license = "professional"
        provider.gui = machine[:gui]
        provider.vmx["displayName"] = "Eye of Sauron - #{name}"
        provider.vmx["memsize"] = machine[:memory].to_s
        provider.vmx["numvcpus"] = machine[:cpus].to_s

        # Some desktop boxes ship with HGFS explicitly disabled in their VMX,
        # which wins over Vagrant's synced-folder configuration.
        provider.vmx["isolation.tools.hgfs.disable"] = "FALSE"

        # The Kali box enables a second USB HID mouse in addition to VMware's
        # virtual PS/2 pointer. Xfce sees both devices and can hide the cursor.
        if name == "attacker"
          # Kali's box uses virtual hardware 8, which can leave the mouse
          # cursor invisible on current VMware Workstation releases.
          provider.vmx["virtualHW.version"] = "20"
          provider.vmx["usb.present"] = "FALSE"
          provider.vmx["usb.generic.allowHID"] = "FALSE"
          provider.vmx["usb:0.present"] = "FALSE"
          provider.vmx["usb:1.present"] = "FALSE"
        end
      end

      if name == "ids"
        node.vm.provision "file",
          source: "../README.md",
          destination: "/tmp/eye-of-sauron-README.md"
        node.vm.provision "file",
          source: "../pyproject.toml",
          destination: "/tmp/eye-of-sauron-pyproject.toml"
        node.vm.provision "file",
          source: "../uv.lock",
          destination: "/tmp/eye-of-sauron-uv.lock"
        node.vm.provision "file",
          source: "../src",
          destination: "/tmp/eye-of-sauron-src"
      end

      node.vm.provision "file",
        source: "provision/zshrc",
        destination: "/tmp/eye-of-sauron-zshrc"
      node.vm.provision "shell", path: "provision/zsh.sh"
      node.vm.provision "shell", path: machine[:provision]
      node.vm.provision "no_sleep", type: "shell", path: "provision/no-sleep.sh"

      if name == "target" || name == "ids"
        node.vm.provision "shell", path: "provision/desktop.sh"
      end
    end
  end
end
