# Vagrant state and VMware images are generated locally, never shared in Git.
**/.vagrant/
*.box
*.ova
*.vmdk
*.vmem
*.vmsn
*.vmss
*.vmx

# Packet captures may be large or contain sensitive traffic.
*.pcap
*.pcapng

# Python environments, caches, and generated files.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
